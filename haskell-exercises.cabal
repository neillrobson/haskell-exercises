name:           haskell-exercises
version:        0.1.0.0
description:    Please see the README on GitHub at <https://github.com/neillrobson/haskell-exercises#readme>
homepage:       https://github.com/neillrobson/haskell-exercises#readme
bug-reports:    https://github.com/neillrobson/haskell-exercises/issues
author:         Neill Robson
maintainer:     neill@neillrobson.com
copyright:      2025 - Present
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md

source-repository head
  type: git
  location: https://github.com/neillrobson/haskell-exercises

library
  exposed-modules:
      FirstPrinciples.Addition
      HaskellBrainTeasers.FirstFourDigitPrime
      HaskellBrainTeasers.SayCheese
      HaskellBrainTeasers.VeryFullStack
  hs-source-dirs:
      src
  default-extensions:
      DataKinds
  ghc-options: -Wall
  build-depends:
      QuickCheck
    , base >=4.7 && <5
    , checkers
    , containers
    , criterion
    , hspec
    , random
    , raw-strings-qq
    , scotty
    , text
    , transformers
    , trifecta
  default-language: Haskell2010
